{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "shell-preview",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "$env:Path = [Environment]::GetEnvironmentVariable('Path','Machine') + ';' + [Environment]::GetEnvironmentVariable('Path','User'); $env:AUTH_PREVIEW = 'true'; $env:NEXT_DIST_DIR = '.next-e2e'; node node_modules/next/dist/bin/next dev -p 3100"
      ],
      "port": 3100
    }
  ]
}

# Copy this file to .env.local and fill it in. docs/SETUP.md explains where each value comes from.
# Only variables starting with NEXT_PUBLIC_ reach the browser. Never add that prefix to a secret.

# --- Needed from Phase 0 ---

# Supabase project URL. Public: the browser needs it.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable key (sb_publishable_...). Public: safe because RLS guards every table.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Supabase secret key (sb_secret_...). SERVER ONLY: it bypasses RLS. Used only by cron jobs.
SUPABASE_SECRET_KEY=sb_secret_xxx

# The one Google account allowed in. SERVER ONLY.
ALLOWED_EMAIL=you@example.com

# Random string that Vercel Cron sends as "Authorization: Bearer ...". SERVER ONLY.
CRON_SECRET=generate-a-long-random-string

# --- Local development only. Never set this on Vercel. ---

# Set to true to view the app shell without logging in. Production builds ignore it.
# AUTH_PREVIEW=true

# --- Needed from later phases. Leave commented out until then. ---

# Phase 4: The Oracle. Switching AI provider only means changing these. All SERVER ONLY.
# Any service using the OpenAI chat format works. AI_PROVIDER also names the key: "groq" reads GROQ_API_KEY.
# The first three have these defaults, so with Groq only the key is required.
# AI_PROVIDER=groq
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=openai/gpt-oss-20b
# GROQ_API_KEY=

# Phase 5: The Treasury. US stock prices. Without it, US prices are set by hand. SERVER ONLY.
# FINNHUB_API_KEY=

# Phase 7: push notifications. The public key is meant for the browser; the private key is SERVER ONLY.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
